---
import "../styles/global.css";
const { title = "Mountain Greece", description = "Mountain activities in Greece", lang = "de", path = "/" } = Astro.props;
const base = "https://example.com"; // replace later
const canonical = `${base}${path}`;
const altDe = `${base}${path.replace(/^\/(en)/, "/de")}`;
const altEn = `${base}${path.replace(/^\/(de)/, "/en")}`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="de" href={altDe} />
    <link rel="alternate" hreflang="en" href={altEn} />
    <link rel="alternate" hreflang="x-default" href={`${base}/de/`} />
  </head>
  <body class="bg-base-100 text-base-content font-sans antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-primary-600 focus:text-white focus:px-4 focus:py-2 focus:rounded-lg">
      {lang === "de" ? "Zum Inhalt springen" : "Skip to content"}
    </a>
    <slot />
  </body>
</html>
