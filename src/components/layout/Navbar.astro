---
import { dict } from "../../i18n";

const { lang = "de" } = Astro.props;
const t = dict[lang].nav;
const isDe = lang === "de";
const links = [
  { label: t.packages, href: isDe ? "/de/packages" : "/en/packages" },
  { label: t.whyGreece, href: isDe ? "/de/why-greece" : "/en/why-greece" },
  { label: t.practicalInfo, href: isDe ? "/de/contact" : "/en/contact" },
];
---
<header class="sticky top-0 z-50 bg-base-100/90 backdrop-blur border-b border-neutral-200 shadow-sm">
  <nav class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between" aria-label="Main">
    <a href={isDe ? "/de/" : "/en/"} class="font-serif text-2xl font-bold text-primary-700 tracking-tight">
      Mountain Greece
    </a>
    <div class="hidden md:flex items-center gap-7 text-sm font-medium text-neutral-600">
      {links.map((link) => (
        <a href={link.href} class="hover:text-primary-700 transition-colors">
          {link.label}
        </a>
      ))}
      <a
        href={isDe ? "/de/contact" : "/en/contact"}
        class="btn btn-sm bg-primary-600 text-white border-none rounded-full px-5 hover:bg-primary-700"
      >
        {t.contact}
      </a>
      <a href={isDe ? "/en/" : "/de/"} class="text-xs font-semibold uppercase tracking-widest text-neutral-400 hover:text-primary-600 transition-colors">
        {isDe ? "EN" : "DE"}
      </a>
    </div>
    <button
      id="nav-toggle"
      type="button"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="nav-menu"
      class="md:hidden p-2 text-neutral-600 hover:text-primary-700 focus:outline-none"
    >
      <svg id="nav-icon-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="nav-icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </nav>
  <div id="nav-menu" class="hidden md:hidden border-t border-neutral-200">
    <div class="max-w-6xl mx-auto px-4 py-4 flex flex-col gap-3 text-sm font-medium text-neutral-600">
      {links.map((link) => (
        <a href={link.href} class="py-2 hover:text-primary-700 transition-colors">
          {link.label}
        </a>
      ))}
      <a
        href={isDe ? "/de/contact" : "/en/contact"}
        class="btn btn-sm bg-primary-600 text-white border-none rounded-full px-5 hover:bg-primary-700 w-fit"
      >
        {t.contact}
      </a>
      <a href={isDe ? "/en/" : "/de/"} class="py-2 text-xs font-semibold uppercase tracking-widest text-neutral-400 hover:text-primary-600 transition-colors">
        {isDe ? "EN" : "DE"}
      </a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("nav-menu");
  const iconOpen = document.getElementById("nav-icon-open");
  const iconClose = document.getElementById("nav-icon-close");

  toggle.addEventListener("click", () => {
    const isOpen = menu.classList.contains("flex");
    menu.classList.toggle("flex", !isOpen);
    menu.classList.toggle("hidden", isOpen);
    iconClose.classList.toggle("hidden", !isOpen);
    iconOpen.classList.toggle("hidden", isOpen);
    toggle.setAttribute("aria-expanded", String(!isOpen));
  });
</script>
