---
import { dict } from "../../i18n";

const { lang = "de" } = Astro.props;
const t = dict[lang].footer;
const nav = dict[lang].nav;
const isDe = lang === "de";
const year = new Date().getFullYear();
---
<footer class="bg-primary-900 text-primary-100 mt-20">
  <div class="max-w-6xl mx-auto px-4 py-14 grid gap-10 md:grid-cols-3">
    <div>
      <a href={isDe ? "/de/" : "/en/"} class="font-serif text-2xl font-bold text-white">Mountain Greece</a>
      <p class="mt-4 text-sm leading-relaxed text-primary-200 max-w-xs">{t.tagline}</p>
    </div>
    <div>
      <h3 class="text-xs font-semibold uppercase tracking-widest text-primary-300">{t.quickLinks}</h3>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li><a href={isDe ? "/de/packages" : "/en/packages"} class="text-primary-100 hover:text-white transition-colors">{nav.packages}</a></li>
        <li><a href={isDe ? "/de/why-greece" : "/en/why-greece"} class="text-primary-100 hover:text-white transition-colors">{nav.whyGreece}</a></li>
        <li><a href={isDe ? "/de/contact" : "/en/contact"} class="text-primary-100 hover:text-white transition-colors">{nav.contact}</a></li>
      </ul>
    </div>
    <div>
      <h3 class="text-xs font-semibold uppercase tracking-widest text-primary-300">{t.contact}</h3>
      <ul class="mt-4 space-y-2.5 text-sm">
        <li><a href={isDe ? "/de/contact" : "/en/contact"} class="text-primary-100 hover:text-white transition-colors">hello@mountaingreece.example</a></li>
        <li><a href={isDe ? "/de/contact" : "/en/contact"} class="text-primary-100 hover:text-white transition-colors">+30 2710 000 000</a></li>
        <li class="text-primary-300">Tripolis, Peloponnes</li>
      </ul>
    </div>
  </div>
  <div class="border-t border-primary-800">
    <div class="max-w-6xl mx-auto px-4 py-6 text-sm text-primary-300 flex flex-col sm:flex-row items-center justify-between gap-3">
      <p>© {year} Mountain Greece. {t.rights}</p>
      <a href={isDe ? "/en/" : "/de/"} class="text-xs font-semibold uppercase tracking-widest hover:text-white transition-colors">
        {isDe ? "English" : "Deutsch"}
      </a>
    </div>
  </div>
</footer>
