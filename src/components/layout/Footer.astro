---
import type { Lang } from "../../lib/routes";
import type { SanitySiteContent, SanitySettings } from "../../lib/sanityTypes";
import {
  getHomePath,
  getLanguageSwitchPath,
  getPagePath,
  primaryNavigation,
  type PageId,
} from "../../lib/routes";

interface Props {
  lang?: Lang;
  footer?: SanitySiteContent["footer"];
  brand?: Pick<SanitySettings, "brandName" | "address" | "email" | "phone"> | null;
}

const { lang = "de", footer, brand } = Astro.props;

const pick = (obj?: { de?: string; en?: string } | null): string =>
  (obj?.[lang] ?? obj?.de) ?? "";

const brandName = brand?.brandName ?? "OLVIOS Outdoor Activities";
const year = new Date().getFullYear();

// Nav labels used in quick links (same keys as Navbar)
const navLabels: Record<string, string> = {
  activities: lang === "de" ? "Aktivitäten" : "Activities",
  region: lang === "de" ? "Die Region" : "The Region",
  about: lang === "de" ? "Über OLVIOS" : "About OLVIOS",
  practicalInformation: lang === "de" ? "Praktische Informationen" : "Practical Information",
  contact: lang === "de" ? "Kontakt" : "Contact Us",
};

const switchHref = getLanguageSwitchPath(Astro.url.pathname, lang);
---
<footer class="bg-primary-900 text-primary-100 mt-20">
  <div class="max-w-7xl mx-auto px-5 py-14 grid gap-10 md:grid-cols-[1.2fr_1fr_1fr] md:px-8">

    {/* Brand */}
    <div>
      <a href={getHomePath(lang)} class="font-serif text-2xl font-bold text-white">
        {brandName}
      </a>
      <p class="mt-4 text-sm leading-relaxed text-primary-200 max-w-xs">
        {pick(footer?.tagline)}
      </p>
    </div>

    {/* Quick links */}
    <div>
      <h3 class="text-xs font-semibold uppercase tracking-widest text-primary-300">
        {pick(footer?.quickLinks) || (lang === "de" ? "Schnellzugriff" : "Quick Links")}
      </h3>
      <ul class="mt-4 grid grid-cols-1 gap-2.5 text-sm sm:grid-cols-2 md:grid-cols-1">
        {primaryNavigation.map((pageId: PageId) => (
          <li>
            <a href={getPagePath(lang, pageId)} class="text-primary-100 hover:text-white transition-colors">
              {navLabels[pageId]}
            </a>
          </li>
        ))}
        <li>
          <a href={getPagePath(lang, "contact")} class="text-primary-100 hover:text-white transition-colors">
            {navLabels.contact}
          </a>
        </li>
      </ul>
    </div>

    {/* Contact column */}
    <div>
      <h3 class="text-xs font-semibold uppercase tracking-widest text-primary-300">
        {pick(footer?.contact) || (lang === "de" ? "Kontakt" : "Contact")}
      </h3>
      <p class="mt-4 text-sm text-primary-200">{pick(footer?.contactText)}</p>
      <a
        href={getPagePath(lang, "contact")}
        class="mt-3 inline-flex text-sm font-bold text-white underline decoration-secondary-400 decoration-2 underline-offset-4 hover:text-secondary-200"
      >
        {navLabels.contact}
      </a>
      {brand?.address && (
        <p class="mt-5 text-sm text-primary-300">{brand.address}</p>
      )}
      {brand?.email && (
        <a href={`mailto:${brand.email}`} class="mt-2 block text-sm text-primary-300 hover:text-white">
          {brand.email}
        </a>
      )}
      {brand?.phone && (
        <a href={`tel:${brand.phone}`} class="mt-1 block text-sm text-primary-300 hover:text-white">
          {brand.phone}
        </a>
      )}
    </div>

  </div>

  <div class="border-t border-primary-800">
    <div class="max-w-7xl mx-auto px-5 py-6 text-sm text-primary-300 flex flex-col sm:flex-row items-center justify-between gap-3 md:px-8">
      <p>© {year} {brandName}. {pick(footer?.rights)}</p>
      <a
        href={switchHref}
        hreflang={lang === "de" ? "en" : "de"}
        class="text-xs font-semibold uppercase tracking-widest hover:text-white transition-colors"
      >
        {lang === "de" ? "English" : "Deutsch"}
      </a>
    </div>
  </div>
</footer>
