---
// ContentPage renders any Sanity `page` document.
//
// Section layouts are editor-controlled via the `layout` field:
//   "cards"      – responsive grid of feature cards (default)
//   "list"       – numbered vertical list
//   "timeline"   – chronological bullet list
//   "paragraphs" – plain prose blocks
//
import type { Lang, PageId } from "../../lib/routes";
import type { SanityPage, SanityPageItem, SanityPageSection } from "../../lib/sanityTypes";
import { getPagePath } from "../../lib/routes";

interface Props {
  lang: Lang;
  content: SanityPage;
}

const { lang, content } = Astro.props;

// Pick the correct language value, falling back to German
const pick = (obj?: { de?: string; en?: string } | null): string =>
  (obj?.[lang] ?? obj?.de) ?? "";

// "On this page" label — UI chrome, kept inline
const sectionLabel = lang === "de" ? "Auf dieser Seite" : "On this page";

function itemNumber(index: number) {
  return String(index + 1).padStart(2, "0");
}

function itemBorderClass(item: SanityPageItem) {
  return item.note ? "border-secondary-300" : "border-neutral-200";
}

const sections = content.sections ?? [];
const highlights = content.highlights ?? [];

// Resolve the closing CTA href from a pageId
const closingHref =
  content.closing?.hrefPageId
    ? getPagePath(lang, content.closing.hrefPageId as PageId)
    : `/${lang}/`;
---

<article>

  {/* ── Hero header ──────────────────────────────────────────────── */}
  <header class="relative isolate overflow-hidden bg-primary-900 text-white">
    <div class="absolute inset-0 opacity-40" aria-hidden="true">
      <svg class="h-full w-full" viewBox="0 0 1440 700" preserveAspectRatio="xMidYMid slice">
        <defs>
          <linearGradient id="terrain" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#0d4a7e" />
            <stop offset="0.55" stop-color="#082e5c" />
            <stop offset="1" stop-color="#311809" />
          </linearGradient>
        </defs>
        <rect width="1440" height="700" fill="url(#terrain)" />
        <g fill="none" stroke="currentColor" stroke-width="1.2" class="text-primary-300/50">
          <path d="M-90 540C130 410 235 590 450 455s335-55 475-145 335-75 610 75" />
          <path d="M-80 585C120 455 280 625 480 500s320-75 480-150 330-45 570 80" />
          <path d="M-70 630C155 500 305 665 520 545s335-85 490-145 310-25 500 70" />
          <path d="M820-70c-80 105-20 175 80 205s145 120 70 205-35 160 90 195 180 115 115 235" />
          <path d="M880-70c-75 110-5 155 90 195s140 115 75 205-25 145 90 185 170 105 115 215" />
        </g>
        <circle cx="1210" cy="155" r="165" fill="#c97f4a" opacity="0.14" />
      </svg>
    </div>

    <div class="relative mx-auto grid max-w-7xl gap-12 px-5 pb-16 pt-20 md:px-8 md:pb-24 md:pt-28 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-end">
      <div class="max-w-4xl">
        <p class="mb-5 text-xs font-semibold uppercase tracking-[0.24em] text-secondary-300">
          {pick(content.eyebrow)}
        </p>
        <h1 class="m-0 font-serif text-4xl font-bold leading-[1.08] text-white md:text-6xl lg:text-7xl">
          {pick(content.title)}
        </h1>
        <p class="mb-0 mt-7 max-w-3xl text-lg leading-relaxed text-primary-100 md:text-xl">
          {pick(content.intro)}
        </p>
      </div>

      {highlights.length > 0 && (
        <dl class="grid grid-cols-3 gap-px overflow-hidden rounded-2xl border border-white/15 bg-white/10 backdrop-blur-sm lg:grid-cols-1">
          {highlights.map((h) => (
            <div class="min-w-0 bg-primary-900/40 px-4 py-5 lg:px-6">
              <dt class="mb-1 text-[0.65rem] uppercase tracking-[0.16em] text-primary-200">
                {pick(h.label)}
              </dt>
              <dd class="m-0 font-serif text-lg font-bold text-white md:text-xl">
                {pick(h.value)}
              </dd>
            </div>
          ))}
        </dl>
      )}
    </div>
  </header>

  {/* ── "On this page" section nav ─────────────────────────────── */}
  {sections.length > 0 && (
    <nav class="border-b border-neutral-200 bg-base-100" aria-label={sectionLabel}>
      <div class="mx-auto flex max-w-7xl gap-6 overflow-x-auto px-5 py-4 md:px-8">
        <span class="shrink-0 text-xs font-semibold uppercase tracking-[0.18em] text-neutral-400">
          {sectionLabel}
        </span>
        {sections.map((section) => (
          <a
            class="shrink-0 text-sm font-semibold text-primary-700 hover:text-secondary-600"
            href={`#${section.id}`}
          >
            {pick(section.title)}
          </a>
        ))}
      </div>
    </nav>
  )}

  {/* ── Page sections ───────────────────────────────────────────── */}
  <div class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-24">
    {sections.map((section, sectionIndex) => {
      const layout = section.layout;
      const items = section.items ?? [];
      const paragraphs = section.paragraphs ?? [];
      const isTimeline = layout === "timeline";

      return (
        <section
          id={section.id}
          class:list={[
            "scroll-mt-28 border-t border-neutral-200 py-14 first:border-t-0 first:pt-0 md:py-20",
            isTimeline && "grid gap-10 lg:grid-cols-[0.7fr_1.3fr]",
          ]}
        >
          {/* Section heading */}
          <div class:list={[!isTimeline && "max-w-3xl"]}>
            {section.eyebrow && (
              <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-secondary-600">
                {pick(section.eyebrow)}
              </p>
            )}
            <h2 class="m-0 font-serif text-3xl font-bold leading-tight text-primary-900 md:text-5xl">
              {pick(section.title)}
            </h2>
            {section.intro && (
              <p class="mb-0 mt-5 text-lg leading-relaxed text-neutral-600">
                {pick(section.intro)}
              </p>
            )}
          </div>

          {/* ── Prose paragraphs layout ─────────────────────────────── */}
          {layout === "paragraphs" && paragraphs.length > 0 && (
            <div class="mt-8 grid gap-6 text-lg leading-relaxed text-neutral-600 md:grid-cols-2">
              {paragraphs.map((p) => (
                <p class="m-0">{pick(p)}</p>
              ))}
            </div>
          )}

          {/* ── Timeline layout ─── chronological bullet list ──────── */}
          {layout === "timeline" && items.length > 0 && (
            <ol class="relative m-0 grid list-none gap-0 border-l border-secondary-300 pl-0">
              {items.map((item, itemIndex) => (
                <li class="relative py-5 pl-8 first:pt-0 last:pb-0">
                  <span
                    class:list={[
                      "absolute -left-1.5 h-3 w-3 rounded-full border-2 border-base-100 bg-secondary-500",
                      itemIndex === 0 ? "top-1" : "top-7",
                    ]}
                    aria-hidden="true"
                  />
                  {item.eyebrow && (
                    <p class="mb-1 text-xs font-semibold uppercase tracking-[0.18em] text-secondary-600">
                      {pick(item.eyebrow)}
                    </p>
                  )}
                  <h3 class="m-0 font-serif text-xl font-bold text-primary-900">{pick(item.title)}</h3>
                  <p class="mb-0 mt-2 text-neutral-600">{pick(item.text)}</p>
                </li>
              ))}
            </ol>
          )}

          {/* ── List layout ─── numbered vertical list ──────────────── */}
          {layout === "list" && items.length > 0 && (
            <ol class="mt-10 m-0 grid list-none gap-0 border-y border-neutral-200 p-0">
              {items.map((item, itemIndex) => (
                <li class="grid gap-3 border-b border-neutral-200 py-7 last:border-b-0 md:grid-cols-[4rem_0.75fr_1.25fr] md:items-start">
                  <span class="font-mono text-xs font-bold text-secondary-500" aria-hidden="true">
                    {itemNumber(itemIndex)}
                  </span>
                  <h3 class="m-0 font-serif text-xl font-bold text-primary-900">{pick(item.title)}</h3>
                  <p class="m-0 text-neutral-600">{pick(item.text)}</p>
                </li>
              ))}
            </ol>
          )}

          {/* ── Cards layout (default) ─── responsive feature grid ─── */}
          {(!layout || layout === "cards") && items.length > 0 && (
            <div class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
              {items.map((item, itemIndex) => {
                const meta = item.meta?.[lang] ?? item.meta?.de ?? [];
                const note = pick(item.note);
                const linkLabel = pick(item.linkLabel);
                return (
                  <article class:list={["flex h-full flex-col rounded-2xl border bg-white p-6 shadow-sm", itemBorderClass(item)]}>
                    <div class="mb-6 flex items-center justify-between gap-4">
                      <span class="font-mono text-xs font-bold text-secondary-500">
                        {pick(item.eyebrow) || itemNumber(itemIndex)}
                      </span>
                      {sectionIndex === 0 && (
                        <span class="h-px flex-1 bg-gradient-to-r from-secondary-300 to-transparent" aria-hidden="true" />
                      )}
                    </div>
                    <h3 class="m-0 font-serif text-2xl font-bold leading-tight text-primary-900">{pick(item.title)}</h3>
                    <p class="mb-0 mt-4 flex-1 text-neutral-600">{pick(item.text)}</p>
                    {meta.length > 0 && (
                      <ul class="mt-6 flex list-none flex-wrap gap-2 p-0">
                        {meta.map((tag) => (
                          <li class="rounded-full bg-primary-50 px-3 py-1 text-xs font-semibold text-primary-700">
                            {tag}
                          </li>
                        ))}
                      </ul>
                    )}
                    {note && (
                      <p class="mb-0 mt-6 border-l-2 border-secondary-500 pl-4 text-sm font-medium text-neutral-700">
                        {note}
                      </p>
                    )}
                    {item.href && linkLabel && (
                      <a class="mt-6 text-sm font-bold text-primary-700" href={item.href}>
                        {linkLabel}
                      </a>
                    )}
                  </article>
                );
              })}
            </div>
          )}

          {/* Section-level note / info box */}
          {section.note && pick(section.note) && (
            <aside class:list={[
              "mt-10 rounded-2xl border border-accent-200 bg-accent-50 px-6 py-5 text-sm leading-relaxed text-accent-900",
              isTimeline && "lg:col-span-2",
            ]}>
              <p class="m-0">{pick(section.note)}</p>
            </aside>
          )}
        </section>
      );
    })}
  </div>

  {/* ── Closing CTA banner ─────────────────────────────────────── */}
  {content.closing && (
    <section class="mx-auto max-w-7xl px-5 pb-4 md:px-8">
      <div class="relative overflow-hidden rounded-3xl bg-secondary-700 px-6 py-12 text-white md:px-12 md:py-16">
        <div class="absolute -right-20 -top-20 h-64 w-64 rounded-full border-[3rem] border-white/5" aria-hidden="true" />
        <div class="relative max-w-3xl">
          <p class="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-secondary-200">
            {pick(content.closing.eyebrow)}
          </p>
          <h2 class="m-0 font-serif text-3xl font-bold text-white md:text-5xl">
            {pick(content.closing.title)}
          </h2>
          <p class="mb-0 mt-5 max-w-2xl text-lg text-secondary-100">{pick(content.closing.text)}</p>
          <a
            href={closingHref}
            class="mt-8 inline-flex items-center rounded-full bg-white px-6 py-3 text-sm font-bold text-secondary-800 transition-transform hover:-translate-y-0.5"
          >
            {pick(content.closing.action)}
            <span class="ml-2" aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </section>
  )}

</article>
