---
import { dict } from "../../i18n";
import { demoPackages, type PackageCard } from "../../lib/demoPackages";

const { lang = "de" } = Astro.props;
const t = dict[lang].home.packages;

function toCard(p: any, lang: string): PackageCard {
  const pick = (obj: any) => obj?.[lang] ?? obj?.de ?? "";
  return {
    slug: p.slug?.current ?? "",
    title: pick(p.title),
    summary: pick(p.summary),
    image: "",
    duration: pick(p.specs?.duration),
    accommodation: pick(p.specs?.accommodation),
    activityType: pick(p.specs?.activityType),
    difficulty: p.specs?.difficultyRating ?? 1,
    priceFrom: p.specs?.priceFrom ?? null,
  };
}

const hasEnv = !!(import.meta.env.PUBLIC_SANITY_PROJECT_ID && import.meta.env.PUBLIC_SANITY_DATASET);

let cards: PackageCard[] = [];

if (hasEnv) {
  try {
    const { sanity, urlFor, q } = await import("../../lib/sanity");
    const data = await sanity.fetch(q.featuredPackages);
    cards = (data ?? []).map((p: any) => {
      const card = toCard(p, lang);
      if (p.heroImage) card.image = urlFor(p.heroImage).width(800).url();
      return card;
    });
  } catch {
    cards = [];
  }
}

if (cards.length === 0) {
  cards = demoPackages[lang];
}

const pricePrefix = lang === "de" ? "ab " : "from ";
const maxDifficulty = 5;
const isDe = lang === "de";
const packagesHref = isDe ? "/de/packages" : "/en/packages";
const detailHref = (slug: string) => (isDe ? `/de/packages/${slug}` : `/en/packages/${slug}`);
---
<section class="mt-16">
  <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">
    <div class="max-w-xl">
      <h2 class="font-serif text-3xl md:text-4xl font-bold text-primary-900">{t.heading}</h2>
      <p class="mt-3 text-neutral-600">{t.subtitle}</p>
    </div>
    <a
      href={packagesHref}
      class="inline-flex items-center gap-1.5 text-sm font-semibold text-primary-600 hover:text-primary-700 whitespace-nowrap"
    >
      {t.viewAll}
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-4 w-4">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
      </svg>
    </a>
  </div>
  <div class="mt-8 grid gap-6 md:grid-cols-3">
    {
      cards.map((card) => (
        <a
          href={detailHref(card.slug)}
          class="group flex flex-col bg-base-100 rounded-2xl overflow-hidden border border-neutral-200 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all"
        >
          {card.image ? (
            <div class="relative overflow-hidden">
              <img src={card.image} alt={card.title} class="w-full h-52 object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
              <span class="absolute top-3 left-3 text-xs font-semibold uppercase tracking-wider text-secondary-800 bg-secondary-100 rounded-full px-3 py-1">
                {card.activityType}
              </span>
            </div>
          ) : (
            <div class="flex items-center justify-center h-52 bg-gradient-to-br from-primary-50 to-secondary-50">
              <span class="text-xs uppercase tracking-widest text-secondary-700">{card.activityType}</span>
            </div>
          )}
          <div class="flex flex-col flex-1 p-6">
            <h3 class="font-serif text-xl font-bold text-primary-900">{card.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-neutral-600 flex-1">{card.summary}</p>
            <div class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-xs text-neutral-500">
              <span>{card.duration}</span>
              <span>{card.accommodation}</span>
            </div>
            <div class="mt-4 flex items-center justify-between border-t border-neutral-100 pt-4">
              <div class="flex items-center gap-1.5" title={`${t.difficulty} ${card.difficulty}/${maxDifficulty}`}>
                <span class="text-xs text-neutral-500">{t.difficulty}</span>
                <span class="flex gap-0.5">
                  {
                    Array.from({ length: maxDifficulty }).map((_, i) => (
                      <span class={`h-2 w-2 rounded-full ${i < card.difficulty ? "bg-secondary-400" : "bg-neutral-300"}`} />
                    ))
                  }
                </span>
              </div>
              {card.priceFrom && (
                <span class="font-mono text-lg font-bold text-secondary-600">{pricePrefix}€{card.priceFrom}</span>
              )}
            </div>
          </div>
        </a>
      ))
    }
  </div>
</section>
