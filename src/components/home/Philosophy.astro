---
import type { Lang } from "../../lib/routes";
import type { SanitySiteContent } from "../../lib/sanityTypes";

interface Props {
  lang?: Lang;
  data?: SanitySiteContent["home"]["philosophy"];
}

const { lang = "de", data } = Astro.props;

const pick = (obj?: { de?: string; en?: string } | null): string =>
  (obj?.[lang] ?? obj?.de) ?? "";

// Map Sanity icon strings to inline SVG markup
const iconSvg: Record<string, string> = {
  users: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-7 w-7"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z"/></svg>`,
  home: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-7 w-7"><path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/></svg>`,
  globe: `<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-7 w-7"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418"/></svg>`,
};

const pillars = data?.pillars ?? [];
const pillarColors = ["bg-primary-600", "bg-secondary-500", "bg-accent-600"];
---
<section class="bg-gradient-to-br from-primary-50 via-base-100 to-secondary-50 rounded-3xl px-6 py-16 md:py-20">
  <div class="max-w-3xl mx-auto text-center">
    <span class="text-xs font-semibold uppercase tracking-widest text-accent-600">{pick(data?.eyebrow)}</span>
    <h2 class="mt-3 font-serif text-3xl md:text-4xl font-bold text-primary-900">{pick(data?.title)}</h2>
    <p class="mt-5 text-lg leading-relaxed text-neutral-600">{pick(data?.body)}</p>
  </div>
  {pillars.length > 0 && (
    <div class="mt-12 grid gap-6 md:grid-cols-3 max-w-5xl mx-auto">
      {pillars.map((p, i) => (
        <div class="bg-base-100 rounded-2xl border border-neutral-200 shadow-sm p-8 text-center hover:shadow-lg hover:-translate-y-1 transition-all">
          <div
            class={`mx-auto flex h-14 w-14 items-center justify-center rounded-full text-white ${pillarColors[i % 3]}`}
            set:html={iconSvg[p.icon ?? "globe"] ?? iconSvg.globe}
          ></div>
          <h3 class="mt-5 font-serif text-xl font-bold text-primary-900">{pick(p.title)}</h3>
          <p class="mt-3 text-sm leading-relaxed text-neutral-600">{pick(p.text)}</p>
        </div>
      ))}
    </div>
  )}
</section>
